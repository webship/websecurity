# Ignore node modules
node_modules
/*/node_modules

# gitlab-ci-local artifacts
.gitlab-ci-local/
# Yarn 4 (Berry) state; the cache is rebuilt by CI.
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# Generated by the webship-js suite and Yarn 4; CI rebuilds them (no lock file is committed, like the other Webship modules).
tests/reports/
screenshots/
yarn.lock
