    "drupal/security_review": "~3.1.0",
    "drupal/honeypot": "~2.2.0",
    "drupal/antibot": "~2.0.0",
    "drupal/klaro": "~3.0.0",
    "drupal/captcha": "^2.0.7",
    "drupal/friendlycaptcha": "^1.1",
    "drupal/friendly_captcha_challenge": "^0.9",
    "drupal/bpmn_io": "^2.0.2",
    "drupal/eca": "^2.1.0-beta1",
    "drupal/login_emailusername": "^3",
