<?php

/**
 * @file
 * Install, update and uninstall functions.
 */

use Drupal\Core\Recipe\Recipe;
use Drupal\Core\Recipe\RecipeRunner;
use Drupal\websecurity\EventSubscriber\FriendlyCaptchaKeysSubscriber;

/**
 * Implements hook_install().
 */
function websecurity_install($is_syncing) {
  // Configuration imports bring their own settings.
  if (\Drupal::isConfigSyncing()) {
    return;
  }

  // When the module is installed on its own, apply its default recipe. When
  // the default recipe installs the module, the recipe is already being
  // applied, and the keys are saved once it is done.
  if (!$is_syncing) {
    RecipeRunner::processRecipe(Recipe::createFromDirectory(__DIR__ . '/recipes/default'));
  }
  \Drupal::service(FriendlyCaptchaKeysSubscriber::class)->setKeys();
}
